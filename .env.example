# 배포 대상. preview | production. 미지정 시 안전하게 preview 로 제한된다.
NEXT_PUBLIC_SITE_DEPLOY_TARGET=preview

# 산출물을 실제로 제공할 origin
NEXT_PUBLIC_SITE_ORIGIN=https://humease21.github.io

# GitHub Pages 프로젝트 사이트의 하위 경로. 커스텀 도메인 연결 시 빈 값.
NEXT_PUBLIC_BASE_PATH=/humease-web-v2

# 색인 승인. production 대상 + 이 값이 true 일 때만 검색에 공개된다.
# basePath 가 비었다는 이유만으로 공개되지 않는다.
NEXT_PUBLIC_SEARCH_INDEXING_ENABLED=false

# IndexNow. 기본 false. 승인된 운영 변경만 제출한다.
INDEXNOW_ENABLED=false

# 문의 기능은 현재 mock/disabled 다. 아래 값은 승인 후에만 설정한다.
# anon key 는 공개 전제이며 RLS 로 보호된다. service_role 키는 절대 넣지 않는다.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
